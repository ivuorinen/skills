.DS_Store
node_modules/
*.local
.ruff_cache/
.pytest_cache/
.venv
__pycache__
.coverage
*.sarif

# findings.py's flock file — must stay on disk for locking, never committed
docs/audit/findings/.lock

# `make index-check` scratch copy — see INDEX_SNAPSHOT in the Makefile
.index-check.before

# Unignore the CLAUDE.md and the whole .claude, then do certain ignores
!CLAUDE.md
!**/.claude/*
.claude/settings.local.json

# Dogfooding symlink: exposes the working-tree skill to Claude Code/Copilot as a project skill
.claude/skills/nitpicker

# Graphify generated output — not tracked
graphify-out/
