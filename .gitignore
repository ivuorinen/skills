.DS_Store
node_modules/
*.local
.ruff_cache/
.pytest_cache/
.venv
__pycache__
.coverage
*.sarif

# Owner-review patches: an agent writes changes to owner-only paths here as a
# diff for the owner to read and apply by hand. Never committed — the patch is
# the delivery mechanism, the commit comes from applying it.
*.patch

# findings.py's flock file — must stay on disk for locking, never committed
docs/audit/findings/.lock

# Scratch copy an older `index-check` wrote; `.mise/tasks/index-check` now
# snapshots to a `mktemp` file instead
.index-check.before

# Unignore the CLAUDE.md and the whole .claude, then do certain ignores
!CLAUDE.md
!**/.claude/*
.claude/settings.local.json

# Dogfooding symlink: exposes the working-tree skill to Claude Code/Copilot as a project skill
.claude/skills/nitpicker

# Graphify generated output — not tracked
graphify-out/
