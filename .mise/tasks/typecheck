#!/usr/bin/env bash
#MISE description="pyright over the repo (0 errors required)"
# Zero floor: any pyright error fails the gate. A count threshold could mask a
# new error by fixing an old one, so the tolerated set must stay empty.
#
# `uv run --extra dev` syncs the .venv pyproject's [tool.pyright] points at;
# the pyright it then runs is mise's pinned one, from PATH.
#
# pyright auto-excludes dot-directories, so the main project never sees the
# hooks under .mise/tasks/hook/. A second pass runs the project rooted there
# (.mise/tasks/hook/pyrightconfig.json), inside which no path starts with a dot.
set -euo pipefail
count='import json,sys; n=json.load(sys.stdin)["summary"]["errorCount"]; print(f"pyright{sys.argv[1]}: {n} error(s)"); sys.exit(n != 0)'
uv run --extra dev pyright --outputjson | python3 -c "$count" ""
uv run --extra dev pyright -p .mise/tasks/hook --outputjson | python3 -c "$count" " (hooks)"
